rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserData() && ('role' in getUserData()) && getUserData().role == 'admin';
    }

    function userTenantId() {
      return hasUserData() && ('tenantId' in getUserData()) ? getUserData().tenantId : '';
    }

    // ── Tenants collection ────────────────────────────────────────────────
    // Authenticated users can read their own tenant or create their personal tenant (tenant_{uid}).
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (
        tenantId == userTenantId() ||
        tenantId == 'tenant_' + request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        tenantId == 'tenant_' + request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        tenantId == userTenantId() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Users collection ──────────────────────────────────────────────────
    // Users can read and create their own profile document. Admins can read/write all.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Valuations collection ─────────────────────────────────────────────
    // Users can only access valuations that belong to their userId AND tenantId.
    match /valuations/{valuationId} {
      allow read: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.tenantId == userTenantId()) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.tenantId == userTenantId() || request.resource.data.tenantId == 'tenant_' + request.auth.uid);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.tenantId == userTenantId();
      allow delete: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.tenantId == userTenantId()) ||
        isAdmin()
      );
    }

    // ── Annotations sub-collection ────────────────────────────────────────
    match /valuations/{valuationId}/annotations/{annotationId} {
      allow read, write: if isAuthenticated() &&
        get(/databases/$(database)/documents/valuations/$(valuationId)).data.userId == request.auth.uid;
    }
  }
}

